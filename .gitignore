# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!frontend/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Data files
*.json
# Exceptions must come AFTER the pattern they override.
# The game/injury data and pre-computed predictions are committed because the
# deployed site reads them and the daily GitHub Action updates them.
!/nhl_games_*.json
!/nhl_injuries*.json
!frontend/data/predictions.json
# Config files that must stay tracked
!package.json
!package-lock.json
!tsconfig.json
!vercel.json
!*.config.json
# frontend/data/ copies of the raw data are build artifacts (copied at build/update time)
frontend/data/nhl_*.json
*.csv
*.db
*.sqlite

# Model files
# The trained models in /models are committed: the daily GitHub Action needs
# them to regenerate predictions. Copies made at Vercel build time are not.
frontend/models/
*.pkl
*.joblib
!/models/*.pkl
!/models/*.txt

# Plot files
plots/
*.png
*.jpg
*.pdf

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local
